# Copy this file to web/.env.local and fill in real values. .env.local is ignored by git.
# These are fake placeholders.
#
# Supabase dashboard -> Project Settings -> API Keys.
# Only the PUBLISHABLE key goes here (starts with sb_publishable_...). It is safe in a
# website because the database's row-level security decides what it can read.
# NEVER put the secret key in the website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
