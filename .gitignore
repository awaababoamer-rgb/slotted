# Secrets - never commit these
.env
.env.*
!.env.example

# Draft My Schedule login sessions, cookies and logs - never commit
.dms-session/
.dms-logs/

# Course data (scraper output). It lives in Supabase, where anyone can read it (guest mode);
# the website loads it from there, so the big JSON file isn't kept in git.
data/courses.json
data/*.json
*storage_state*.json
*cookies*.json
*.har

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Supabase local files
supabase/.temp/
supabase/.branches/
