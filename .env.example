# Copy this file to .env (in the project's top folder) and fill in real values.
# .env is ignored by git. NEVER commit it, paste it in chat, or put it in the website.
# These are fake placeholders.
#
# Used by scraper/upload_to_supabase.py only.
# Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (starts with sb_secret_...). It bypasses all security rules:
# it must only ever be on the computer that runs the upload script.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Chat assistant: main AI (Groq). Stored as a Supabase Edge Function secret; get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key

# Chat assistant backup (Gemini). The real key is stored as a Supabase Edge Function secret;
# this copy is only used by the deploy step. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Lets the Supabase command-line tool deploy the chat function.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-token
