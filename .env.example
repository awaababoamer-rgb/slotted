# Copy this file to .env (in the project's top folder) and fill in real values.
# .env is ignored by git. NEVER commit it, paste it in chat, or put it in the website.
# These are fake placeholders.
#
# Used by scraper/upload_to_supabase.py only.
# Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (starts with sb_secret_...). It bypasses all security rules:
# it must only ever be on the computer that runs the upload script.
SUPABASE_SECRET_KEY=sb_secret_replace_me
